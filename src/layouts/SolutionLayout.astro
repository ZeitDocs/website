---
/**
 * One page per compliance need (WEB-1). Same frame for every solution page: the problem in
 * the buyer's words, the slot for the mapping and the setup, an honest scope note, and the
 * install call to action.
 */
import Icon from '../components/Icon.astro';
import TrustStrip from '../components/TrustStrip.astro';
import SiteLayout from './SiteLayout.astro';
import { marketplaceUrl } from '../utils/links';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lead: string;
  /** Used for the install link's utm_content. */
  slug: string;
}

const { title, description, eyebrow, heading, lead, slug } = Astro.props;
---

<SiteLayout title={title} description={description}>
  <section class="hero">
    <div class="section-inner"><div class="solution-hero">
      <a class="solution-back" href={withBase('/solutions/')}>
        <Icon name="arrow-right" size={14} /> All solutions
      </a>
      <span class="eyebrow">{eyebrow}</span>
      <h1>{heading}</h1>
      <p class="lead">{lead}</p>
      <div class="cta-row">
        <a class="button button-primary" href={marketplaceUrl(`solution-${slug}`)}>
          Get Classify on the Marketplace <Icon name="external" size={16} />
        </a>
        <a class="button button-secondary" href={withBase('/products/classify/#try-it')}>Try the banner</a>
      </div>
    </div></div>
  </section>

  <TrustStrip />

  <slot />

  <section class="section">
    <div class="section-inner">
      <aside class="scope-note" aria-label="Scope of this page">
        <Icon name="shield" size={20} />
        <div>
          <strong>Classify helps you meet these requirements. It does not make you compliant.</strong>
          <p>
            Compliance depends on your policies, processes and the rest of your environment. Classify
            covers the Confluence part: visible levels, labels, level-based restrictions and reports
            you can show an auditor. Review Confluence permissions as well when strict access control
            is required.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="cta-band">
        <div>
          <h2>Start with one space.</h2>
          <p>
            Install Classify, apply a template to one space and classify a few pages. Then roll it
            out to the rest of the site.
          </p>
        </div>
        <div class="cta-row">
          <a class="button button-primary" href={marketplaceUrl(`solution-${slug}-footer`)}>
            Get Classify <Icon name="external" size={16} />
          </a>
          <a class="button button-secondary" href={withBase('/docs/classify/getting-started/')}>Getting started</a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .solution-hero {
    max-width: 820px;
  }

  .solution-back {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    color: var(--zd-blue-700);
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
  }

  .solution-back :global(.zd-icon) {
    rotate: 180deg;
  }

  .scope-note {
    display: flex;
    gap: 14px;
    border: 1px solid var(--zd-orange-100);
    border-left: 4px solid var(--zd-orange-500);
    border-radius: var(--zd-radius-sm);
    background: var(--zd-orange-50);
    padding: 18px 20px;
  }

  .scope-note :global(.zd-icon) {
    flex: none;
    margin-top: 2px;
    color: var(--zd-orange-700);
  }

  .scope-note p {
    margin: 6px 0 0;
    color: var(--zd-gray-700);
    line-height: 1.6;
  }
</style>
