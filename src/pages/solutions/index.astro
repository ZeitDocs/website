---
import Icon from '../../components/Icon.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { withBase } from '../../utils/paths';

/*
 * One page per compliance need (WEB-1). Planned, not yet published:
 * - Government-style markings: waits for the marking strip (CLAS-174) to ship.
 * - NIS2 / DORA / SOC 2: only once the mapping is honest; see the WEB-1 epic.
 */
const SOLUTIONS = [
  {
    href: '/solutions/iso-27001/',
    eyebrow: 'ISO/IEC 27001',
    title: 'Information classification and labelling',
    text: 'Annex A 5.12 and 5.13 in Confluence: a classification scheme, labels on every page and reports for the audit.',
    color: '#0052CC',
  },
  {
    href: '/solutions/gdpr-personal-data/',
    eyebrow: 'GDPR',
    title: 'Personal data in Confluence',
    text: 'Mark the pages that hold personal data, restrict who can open them and find them again when you need to.',
    color: '#FF8B00',
  },
];
---

<SiteLayout
  title="Solutions | Zeitdocs"
  description="How Classify helps Confluence teams meet information classification requirements such as ISO 27001 and GDPR."
>
  <section class="hero">
    <div class="section-inner">
      <span class="eyebrow">Solutions</span>
      <h1>Start from the requirement, not the feature.</h1>
      <p class="lead">
        Each page maps one requirement to what Classify does in Confluence, and to the evidence you
        can show for it.
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="section-inner solution-grid">
      {
        SOLUTIONS.map((s) => (
          <a class="solution-card" href={withBase(s.href)} style={`--lvl: ${s.color}`}>
            <span class="eyebrow">{s.eyebrow}</span>
            <h2>{s.title}</h2>
            <p>{s.text}</p>
            <span class="solution-card__more">
              Read more <Icon name="arrow-right" size={16} />
            </span>
          </a>
        ))
      }
    </div>
  </section>
</SiteLayout>

<style>
  .solution-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .solution-card {
    display: grid;
    align-content: start;
    gap: 10px;
    border: var(--zd-border);
    border-top: 4px solid var(--lvl);
    border-radius: var(--zd-radius-md);
    background: var(--zd-white);
    box-shadow: var(--zd-shadow-card);
    color: inherit;
    padding: 26px;
    text-decoration: none;
    transition: box-shadow 160ms ease, translate 160ms ease;
  }

  .solution-card:hover {
    box-shadow: var(--zd-shadow-soft);
    translate: 0 -2px;
  }

  .solution-card h2 {
    margin: 0;
    font-size: 1.35rem;
  }

  .solution-card p {
    margin: 0;
    color: var(--zd-gray-700);
    line-height: 1.6;
  }

  .solution-card__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    color: var(--zd-blue-700);
    font-weight: 650;
  }

  @media (max-width: 760px) {
    .solution-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
