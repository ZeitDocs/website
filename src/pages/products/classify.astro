---
import { Image } from 'astro:assets';
import FeatureCard from '../../components/FeatureCard.astro';
import Icon from '../../components/Icon.astro';
import ProductMock from '../../components/ProductMock.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import bylineShot from '../../assets/site/byline-picker.png';
import complianceShot from '../../assets/site/16-compliance-overview.png';
import { MARKETPLACE_CLASSIFY } from '../../utils/links';
import { withBase } from '../../utils/paths';

const LEVELS = [
  { name: 'Public', color: '#1F845A', text: 'Safe to share outside the company. No restrictions.' },
  { name: 'Internal', color: '#0C66E4', text: 'For employee-only documentation and internal operating pages.' },
  { name: 'Confidential', color: '#C25100', text: 'For sensitive content that named teams should handle with care.' },
  { name: 'Restricted', color: '#AE2E24', text: 'For highly sensitive content that needs limited view and edit access.' },
];
---

<SiteLayout
  title="Classify | Zeitdocs"
  description="Classify helps Confluence teams classify pages with visual banners, labels and level-based view and edit restrictions."
>
  <section class="hero">
    <div class="section-inner hero-grid">
      <div>
        <div class="product-hero-kicker">
          <img
            class="product-hero-logo"
            src={withBase('/assets/products/classify-logo.png')}
            alt=""
            width="256"
            height="256"
            decoding="async"
          />
          <span class="eyebrow">Classify for Confluence Cloud</span>
        </div>
        <h1>Page permissions and visual security banners.</h1>
        <p class="lead">
          Define classification levels once. Editors pick one from the page byline, and Classify
          shows the banner, adds the label and applies the level's view and edit restrictions.
        </p>
        <div class="cta-row">
          <a class="button button-primary" href={MARKETPLACE_CLASSIFY}>
            Get Classify on the Marketplace <Icon name="external" size={16} />
          </a>
          <a class="button button-secondary" href={withBase('/docs/classify/')}>Read the docs</a>
        </div>
      </div>
      <ProductMock />
    </div>
  </section>

  <TrustStrip />

  <section class="section">
    <div class="section-inner split-grid">
      <div>
        <span class="eyebrow">The problem</span>
        <h2>Sensitive pages should not look like ordinary pages.</h2>
      </div>
      <div>
        <p>
          Confluence pages can hold public, internal, confidential or restricted information.
          Permissions may exist in the background, but readers and editors rarely see a clear
          signal, and restricting each page by hand doesn't scale.
        </p>
        <p>
          Classify makes the classification visible where people look first, and ties the
          restrictions to the level, so choosing the level is all an editor has to do.
        </p>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="section-inner">
      <div class="section-heading">
        <span class="eyebrow">What it does</span>
        <h2>Everything a classification policy needs, inside Confluence.</h2>
      </div>
      <div class="card-grid">
        <FeatureCard
          icon="shield"
          title="Classification levels"
          text="Define your own levels with a colour, description and label, or start from a ready-made template."
        />
        <FeatureCard
          icon="banner"
          title="Visual banners"
          text="A banner at the top of every classified page, designed per level in the Banner Studio."
          accent="orange"
        />
        <FeatureCard
          icon="lock"
          title="Level-based restrictions"
          text="Each level carries its own view and edit groups, applied when an editor classifies the page."
        />
        <FeatureCard
          icon="template"
          title="Templates and rollout"
          text="Apply a scheme to hundreds of spaces in one background job, and re-apply it when it changes."
          accent="orange"
        />
        <FeatureCard
          icon="users"
          title="Space access control"
          text="Choose which spaces may use classification: all of them, an allow list or a block list."
        />
        <FeatureCard
          icon="chart"
          title="Reports and compliance"
          text="A report per space, a Compliance dashboard for the whole site, and CSV export for both."
          accent="orange"
        />
      </div>
    </div>
  </section>

  <section class="section band--blue">
    <div class="section-inner">
      <div class="showcase">
        <div class="showcase__text">
          <span class="eyebrow">For editors</span>
          <h2>Classify a page in one click.</h2>
          <p>
            The level picker lives in the page byline. Editors see each level's description, pick
            one, and Classify takes care of the banner, label and restrictions.
          </p>
          <a class="button button-secondary" href={withBase('/docs/classify/classifying-a-page/')}>
            Classifying a page <Icon name="arrow-right" size={16} />
          </a>
        </div>
        <figure class="shot">
          <Image
            src={bylineShot}
            alt="A Confluence page with the Classify level picker open from the byline, listing the space's classification levels."
            sizes="(max-width: 900px) calc(100vw - 32px), 680px"
            widths={[680, 840]}
          />
        </figure>
      </div>
      <div class="showcase showcase--flip">
        <div class="showcase__text">
          <span class="eyebrow">For admins</span>
          <h2>See where the policy is in use.</h2>
          <p>
            The Compliance dashboard shows coverage across every space, flags pages on deleted
            levels and pages left behind, and exports everything as CSV.
          </p>
          <a class="button button-secondary" href={withBase('/docs/classify/compliance-dashboard/')}>
            Compliance dashboard <Icon name="arrow-right" size={16} />
          </a>
        </div>
        <figure class="shot">
          <Image
            src={complianceShot}
            alt="The Compliance dashboard with the share of spaces enabled, status tiles and charts."
            sizes="(max-width: 900px) calc(100vw - 32px), 680px"
            widths={[680, 1100, 1568]}
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="section-heading">
        <span class="eyebrow">Example levels</span>
        <h2>A starting point you adapt to your policy.</h2>
        <p>
          These are examples. A Confluence admin adapts the names, descriptions, labels and
          restriction groups to the organisation's own classification policy.
        </p>
      </div>
      <div class="level-list">
        {
          LEVELS.map((l) => (
            <div class="level-item" style={`--lvl: ${l.color}`}>
              <strong>{l.name}</strong>
              <span>{l.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="cta-band">
        <div>
          <h2>Ready to classify your first page?</h2>
          <p>
            Install Classify from the Atlassian Marketplace and follow the getting-started guide:
            apply a template to one space, then pick a level on any page.
          </p>
        </div>
        <div class="cta-row">
          <a class="button button-primary" href={MARKETPLACE_CLASSIFY}>
            Get Classify <Icon name="external" size={16} />
          </a>
          <a class="button button-secondary" href={withBase('/docs/classify/getting-started/')}>Getting started</a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .product-hero-kicker {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .product-hero-logo {
    display: block;
    width: 64px;
    height: 64px;
    object-fit: contain;
  }

  .level-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .level-item {
    display: grid;
    gap: 8px;
    border: var(--zd-border);
    border-top: 4px solid var(--lvl);
    border-radius: var(--zd-radius-sm);
    background: var(--zd-white);
    padding: 18px;
  }

  .level-item strong {
    color: var(--lvl);
    font-size: 1.05rem;
  }

  .level-item span {
    color: var(--zd-gray-700);
    font-size: 0.94rem;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .level-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .product-hero-logo {
      width: 52px;
      height: 52px;
    }

    .level-list {
      grid-template-columns: 1fr;
    }
  }
</style>
