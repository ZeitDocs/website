---
/**
 * Starlight's header has a "social icons" slot on the right. The docs use it for the site's
 * own navigation and the Marketplace button, so moving between the marketing pages and the
 * documentation feels like one site rather than two.
 */
import { marketplaceUrl } from '../../utils/links';

const LINKS = [
  { href: '/', label: 'Home' },
  { href: '/products/', label: 'Products' },
  { href: '/solutions/', label: 'Solutions' },
  { href: '/contact/', label: 'Contact' },
];
---

<nav class="zd-docs-nav" aria-label="Zeitdocs site">
  {LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
  <a class="zd-docs-cta" href={marketplaceUrl('docs-header')}>Get Classify</a>
</nav>

<style>
  .zd-docs-nav {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    white-space: nowrap;
  }

  .zd-docs-nav a {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .zd-docs-nav a:hover {
    color: var(--sl-color-accent);
  }

  /* Same button as the marketing site's primary (global.css .button-primary). */
  .zd-docs-nav .zd-docs-cta {
    border: 1px solid #e3843f;
    border-radius: 10px;
    background: linear-gradient(180deg, #f6a463, #ed9852);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 1px 2px rgba(185, 100, 45, 0.25);
    color: #0f2433;
    font-weight: 620;
    padding: 0.4rem 0.95rem;
  }

  .zd-docs-nav .zd-docs-cta:hover {
    background: linear-gradient(180deg, #f8b07a, #f0a061);
    color: #0f2433;
  }
</style>
