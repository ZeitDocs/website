---
/**
 * The product, not an illustration of it: a Confluence page with a Classify banner, the byline
 * chip and the level picker, built in HTML/CSS so it stays sharp at any size and needs no
 * screenshot to keep up to date. It cycles Internal → Confidential → Restricted with CSS only
 * (no client JavaScript), and holds still on Confidential for people who prefer reduced motion.
 */

const LEVELS = [
  { name: 'Internal', color: '#0C66E4', text: "For employees only. Don't share this page outside the company." },
  { name: 'Confidential', color: '#C25100', text: 'Named teams only. Do not forward, export or copy to other spaces.' },
  { name: 'Restricted', color: '#AE2E24', text: 'Finance leadership only. View and edit restrictions applied.' },
];
const PICKER = [{ name: 'Public', color: '#1F845A' }, ...LEVELS];
---

<figure
  class="mock"
  role="img"
  aria-label="A Confluence page with a Classify banner at the top. The banner and the byline show the page's classification level, here Internal, Confidential or Restricted, and a level picker lets the editor change it."
>
  <div class="mock-window">
    <div class="mock-chrome" aria-hidden="true">
      <span class="mock-dots"><i></i><i></i><i></i></span>
      <span class="mock-url">yourcompany.atlassian.net/wiki</span>
    </div>
    <div class="mock-page" aria-hidden="true">
      <div class="mock-breadcrumb">Finance / Planning / Q3 forecast</div>
      <div class="mock-stack mock-banners">
        {
          LEVELS.map((l, i) => (
            <div class={`mock-banner mock-layer mock-layer--${i}`} style={`--lvl: ${l.color}`}>
              <strong>{l.name}</strong>
              <span>{l.text}</span>
            </div>
          ))
        }
      </div>
      <div class="mock-byline">
        <span class="mock-avatar"></span>
        <span class="mock-muted">Owned by Ana · Updated today</span>
        <span class="mock-stack mock-chips">
          {
            LEVELS.map((l, i) => (
              <span class={`mock-chip mock-layer mock-layer--${i}`} style={`--lvl: ${l.color}`}>
                <i></i>
                {l.name}
              </span>
            ))
          }
        </span>
      </div>
      <div class="mock-title">Q3 revenue forecast</div>
      <div class="mock-lines">
        <i style="width: 94%"></i><i style="width: 86%"></i><i style="width: 91%"></i><i style="width: 58%"></i>
      </div>
      <div class="mock-table">
        <i></i><i></i><i></i><i></i><i></i><i></i>
      </div>
    </div>
  </div>

  <!-- What classifying does, as floating notes beside the page. -->
  <div class="mock-note mock-note--label" aria-hidden="true">
    <span class="mock-note__tick">✓</span> Label added
  </div>
  <div class="mock-note mock-note--lock" aria-hidden="true">
    <span class="mock-note__tick">✓</span> View and edit restricted
  </div>

  <div class="mock-picker" aria-hidden="true">
    <div class="mock-picker__title">Classification</div>
    <div class="mock-picker__list">
      <span class="mock-picker__highlight"></span>
      {
        PICKER.map((l) => (
          <span class="mock-picker__option">
            <i style={`background: ${l.color}`}></i>
            {l.name}
          </span>
        ))
      }
    </div>
  </div>
</figure>

<style>
  .mock {
    --cycle: 9s;
    position: relative;
    width: 100%;
    max-width: 560px;
    margin: 0;
    justify-self: end;
    padding: 0 0 36px;
  }

  .mock-window {
    overflow: hidden;
    border: 1px solid var(--zd-gray-200);
    border-radius: var(--zd-radius-md);
    background: var(--zd-white);
    box-shadow: var(--zd-shadow-soft);
  }

  .mock-chrome {
    display: flex;
    align-items: center;
    gap: 14px;
    border-bottom: 1px solid var(--zd-gray-100);
    background: var(--zd-gray-50);
    padding: 10px 14px;
  }

  .mock-dots {
    display: flex;
    gap: 6px;
  }

  .mock-dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--zd-gray-200);
  }

  .mock-url {
    flex: 1;
    border-radius: 999px;
    background: var(--zd-white);
    box-shadow: inset 0 0 0 1px var(--zd-gray-100);
    color: var(--zd-gray-500);
    font-size: 0.72rem;
    padding: 4px 12px;
  }

  .mock-page {
    padding: 18px 22px 24px;
  }

  .mock-breadcrumb,
  .mock-muted {
    color: var(--zd-gray-500);
    font-size: 0.72rem;
  }

  /* The three levels sit on top of each other in one grid cell and take turns. */
  .mock-stack {
    display: grid;
  }

  .mock-stack > * {
    grid-area: 1 / 1;
  }

  .mock-banners {
    margin: 10px -22px 0;
  }

  /* Drawn like the real Classify banner (vendor/classify-banner): a colour band with the
     level name and description in the banner's own system font and text shadow. */
  .mock-banner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    min-height: 104px;
    background: var(--lvl);
    color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    padding: 16px 22px;
  }

  .mock-banner strong {
    display: block;
    font-size: 1.6rem;
    line-height: 1.1;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
  }

  .mock-banner span {
    display: block;
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.8rem;
    line-height: 1.3;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
  }

  .mock-byline {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
  }

  .mock-avatar {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--zd-blue-300), var(--zd-orange-300));
  }

  .mock-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border: 1px solid var(--zd-gray-200);
    border-radius: 999px;
    color: var(--zd-gray-900);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 2px 8px;
    white-space: nowrap;
  }

  .mock-chip i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lvl);
  }

  .mock-title {
    margin-top: 14px;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .mock-lines {
    display: grid;
    gap: 8px;
    margin-top: 14px;
  }

  .mock-lines i,
  .mock-table i {
    display: block;
    height: 7px;
    border-radius: 99px;
    background: var(--zd-gray-100);
  }

  .mock-table {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-top: 18px;
    border: 1px solid var(--zd-gray-100);
    border-radius: 8px;
    padding: 10px;
  }

  .mock-picker {
    position: absolute;
    right: -18px;
    bottom: 0;
    width: 196px;
    border: 1px solid var(--zd-gray-200);
    border-radius: 12px;
    background: var(--zd-white);
    box-shadow: 0 18px 40px rgba(32, 32, 29, 0.14);
    padding: 12px;
  }

  .mock-picker__title {
    color: var(--zd-gray-700);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mock-picker__list {
    position: relative;
    display: grid;
    margin-top: 8px;
  }

  .mock-picker__option {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    font-size: 0.82rem;
    padding: 0 8px;
  }

  .mock-picker__option i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .mock-picker__highlight {
    position: absolute;
    inset: 0 0 auto;
    height: 32px;
    border-radius: 8px;
    background: var(--zd-blue-50);
    box-shadow: inset 0 0 0 1px var(--zd-blue-100);
    translate: 0 64px;
  }

  /* ── The cycle ─────────────────────────────────────────────────────────────────── */
  .mock-layer {
    opacity: 0;
  }

  .mock-layer--1 {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mock-layer {
      animation: zd-cycle var(--cycle) infinite;
    }

    /* Negative delays start each layer at its own third of the loop. */
    .mock-layer--0 { animation-delay: 0s; }
    .mock-layer--1 { animation-delay: calc(var(--cycle) / -3 * 2); }
    .mock-layer--2 { animation-delay: calc(var(--cycle) / -3); }

    .mock-picker__highlight {
      animation: zd-pick var(--cycle) infinite;
    }
  }

  @keyframes zd-cycle {
    0%, 30% { opacity: 1; }
    33.33%, 96.66% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes zd-pick {
    0%, 30% { translate: 0 32px; }
    33.33%, 63.33% { translate: 0 64px; }
    66.66%, 96.66% { translate: 0 96px; }
    100% { translate: 0 32px; }
  }

  /* ── Floating notes ────────────────────────────────────────────────────────────── */
  .mock-note {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--zd-gray-200);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    box-shadow: var(--zd-shadow-card);
    color: var(--zd-gray-900);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 8px 12px;
    white-space: nowrap;
  }

  .mock-note__tick {
    display: grid;
    width: 18px;
    height: 18px;
    place-items: center;
    border-radius: 50%;
    background: #dcfff1;
    color: #1f845a;
    font-size: 0.7rem;
  }

  .mock-note--label {
    top: 112px;
    right: -30px;
  }

  .mock-note--lock {
    bottom: 64px;
    left: -46px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mock-note {
      animation: zd-float 6s ease-in-out infinite;
    }

    .mock-note--lock {
      animation-delay: -3s;
    }
  }

  @keyframes zd-float {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -6px; }
  }

  @media (max-width: 900px) {
    .mock {
      justify-self: stretch;
      max-width: none;
    }

    .mock-picker {
      right: 12px;
    }

    .mock-note--label {
      right: 12px;
    }

    .mock-note--lock {
      left: 12px;
    }
  }

  @media (max-width: 560px) {
    .mock {
      padding-bottom: 0;
    }

    .mock-picker,
    .mock-note,
    .mock-muted {
      display: none;
    }
  }
</style>
