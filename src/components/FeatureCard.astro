---
import Icon from './Icon.astro';
import type { IconName } from '../utils/icons';

interface Props {
  title: string;
  text: string;
  accent?: 'blue' | 'orange';
  icon?: IconName;
}

const { title, text, accent = 'blue', icon = 'document' } = Astro.props;
---

<article class={`feature-card feature-card--${accent}`}>
  <div class="feature-card__icon">
    <Icon name={icon} size={22} />
  </div>
  <h3>{title}</h3>
  <p>{text}</p>
</article>

<style>
  .feature-card {
    height: 100%;
    border: var(--zd-border);
    border-radius: var(--zd-radius-md);
    background: var(--zd-white);
    box-shadow: var(--zd-shadow-card);
    padding: 28px;
    transition: border-color 260ms ease, box-shadow 260ms var(--zd-ease), translate 260ms var(--zd-ease);
  }

  .feature-card:hover {
    translate: 0 -3px;
    border-color: var(--zd-blue-100);
    box-shadow: var(--zd-shadow-hover);
  }

  .feature-card__icon {
    display: grid;
    width: 44px;
    height: 44px;
    margin-bottom: 18px;
    place-items: center;
    border-radius: 12px;
    background: var(--zd-blue-50);
    border: 1px solid var(--zd-blue-100);
    color: var(--zd-blue-700);
  }

  .feature-card--orange .feature-card__icon {
    background: var(--zd-orange-50);
    border-color: var(--zd-orange-100);
    color: var(--zd-orange-700);
  }

  .feature-card p {
    margin: 10px 0 0;
  }
</style>
